{% comment %}
Animated Carousel — Revissant
- Cross-fade + leve rotate/zoom entre slides
- Editável no editor (image_picker por bloco)
- Autoplay com pause on hover, setas e bullets opcionais
{% endcomment %}

<section id="ac-{{ section.id }}" class="ac-wrapper" style="--ac-bg: {{ section.settings.bg | default: '#f4e07a' }};">
  

  <div class="ac-viewport" style="aspect-ratio: {{ section.settings.aspect_ratio }};">
    {% for block in section.blocks %}
      {% assign img = block.settings.image %}
      {% if img != blank %}
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="ac-slide">{% else %}<div class="ac-slide">{% endif %}
          {{ img | image_url: width: 2000 | image_tag:
            loading: 'lazy',
            class: 'ac-img',
            alt: block.settings.alt | escape
          }}
        {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.show_arrows %}
  <button class="ac-nav ac-prev" aria-label="Anterior"><span>‹</span></button>
  <button class="ac-nav ac-next" aria-label="Seguinte"><span>›</span></button>
  {% endif %}


  {% if section.settings.show_dots %}
  <div class="ac-dots" role="tablist" aria-label="Selecionar slide"></div>
  {% endif %}

  <style>
    #ac-{{ section.id }} { background: transparent; }
    #ac-{{ section.id }}{position:relative; padding: clamp(24px,4vw,40px) 0;}
    #ac-{{ section.id }} .ac-circle{
      position:absolute; inset:auto 0 0 0; top:50%; transform:translateY(-50%);
      margin:auto; width:min(78vmin, 900px); height:min(78vmin, 900px);
      background: var(--ac-bg); border-radius:50%; z-index:0; filter: none;
    }
    #ac-{{ section.id }} .ac-viewport{  position: relative;
      width: min(92vw, 1200px);
      margin: 0 auto;

      background: transparent !important; /* remove fundo */
      box-shadow: none !important;        /* remove sombra de cartão */
      border-radius: 0 !important;         /* remove cantos arredondados */
      overflow: visible;                   /* deixa a imagem “respirar” */
      min-height: clamp(420px, 70vh, 820px);
    }
      
    #ac-{{ section.id }} .ac-slide{
      position:absolute; inset:0; opacity:0; transition: opacity {{ section.settings.transition_ms }}ms ease, transform {{ section.settings.transition_ms }}ms ease;
      display:block;
    }
    #ac-{{ section.id }} .ac-slide.is-active{ opacity:1; transform: none; z-index:2; }
    #ac-{{ section.id }} .ac-slide:not(.is-active){ transform: scale(1.04) rotate(.8deg); }
    #ac-{{ section.id }} .ac-img{ width:100%; height:100%; object-fit:contain; object-position: center; display:block;filter:none; }

    #ac-{{ section.id }} .ac-viewport{ position: relative; } 

    #ac-{{ section.id }} .ac-nav{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      border:0;
      background:rgba(255,255,255,.9);
      color:#111;
      width:46px; height:46px;
      border-radius:999px;
      cursor:pointer;
      font-size:22px;
      line-height:46px;
      text-align:center;
      box-shadow:0 8px 24px rgba(0,0,0,.25);
      z-index:3;
    }

    #ac-{{ section.id }} .ac-prev{ left: clamp(8px, 1.6vw, 24px); }
    #ac-{{ section.id }} .ac-next{ right: clamp(8px, 1.6vw, 24px); }

    #ac-{{ section.id }} .ac-nav > span{
      display:inline-block;
      transition: transform 240ms ease;
    }
    /* Apenas a seta esquerda roda no hover */
    #ac-{{ section.id }} .ac-prev:hover > span {
    transform: none);
    }

    /* A seta direita mantém-se igual, só leva brilho */
    #ac-{{ section.id }} .ac-next:hover > span {
    transform: none;
    }
    #ac-{{ section.id }} .ac-next:hover > span {
    transform: translateX(3px);
    }
    #ac-{{ section.id }} .ac-prev:hover > span {
    transform: translateX(-3px);
    }
    #ac-{{ section.id }} .ac-nav:hover{ filter: brightness(.95); }

    #ac-{{ section.id }} .ac-dots{ display:flex; gap:8px; justify-content:center; margin-top:12px; z-index:2; position:relative; }
    #ac-{{ section.id }} .ac-dot{
      width:8px; height:8px; border-radius:999px; background:#cfcfcf; border:0; cursor:pointer; padding:0;
    }
    #ac-{{ section.id }} .ac-dot[aria-selected="true"]{ background:#111; }
    @media (max-width: 640px){
      #ac-{{ section.id }} .ac-viewport{   position:relative;width:min(92vw, 1200px);margin:0 auto;border-radius:28px;overflow:hidden;background: transparent;min-height: clamp(420px, 70vh, 820px); }
      #ac-{{ section.id }} .ac-circle{ width:min(92vw, 560px); height:min(92vw, 560px); }
    }

 
  </style>

  <script>
    (function(){
      const root = document.getElementById('ac-{{ section.id }}');
      if(!root) return;
      const slides = Array.from(root.querySelectorAll('.ac-slide'));
      if(slides.length === 0) return;

      // Build dots if enabled
      const dotsWrap = root.querySelector('.ac-dots');
      let dots = [];
      if(dotsWrap){
        slides.forEach((_, i) => {
          const b = document.createElement('button');
          b.className = 'ac-dot';
          b.type = 'button';
          b.setAttribute('role','tab');
          b.setAttribute('aria-label','Ir para slide ' + (i+1));
          b.addEventListener('click', () => go(i, true));
          dotsWrap.appendChild(b);
          dots.push(b);
        });
      }

      let i = 0, t = null;
      const AUTOPLAY = {{ section.settings.autoplay | json }};
      const LOOP = {{ section.settings.loop | json }};
      const INTERVAL = {{ section.settings.autoplay_interval | times: 1000 }};
      const TRANSITION = {{ section.settings.transition_ms }};
      const prevBtn = root.querySelector('.ac-prev');
      const nextBtn = root.querySelector('.ac-next');

      function show(idx){
        slides.forEach((s, k) => s.classList.toggle('is-active', k === idx));
        if(dots.length){
          dots.forEach((d, k) => d.setAttribute('aria-selected', k === idx ? 'true' : 'false'));
        }
      }
      function go(next, manual){
        if(next < 0) next = LOOP ? slides.length - 1 : 0;
        if(next >= slides.length) next = LOOP ? 0 : slides.length - 1;
        i = next;
        show(i);
        if(manual) restart();
      }
      function step(){ go(i + 1, false); }
      function start(){
        stop();
        if(AUTOPLAY && slides.length > 1){
          t = setInterval(step, Math.max(INTERVAL, TRANSITION + 120));
        }
      }
      function stop(){ if(t){ clearInterval(t); t = null; } }
      function restart(){ stop(); start(); }

      // Init
      show(0);
      start();

      // Controls
      if(prevBtn) prevBtn.addEventListener('click', () => go(i - 1, true));
      if(nextBtn) nextBtn.addEventListener('click', () => go(i + 1, true));

      // Pause on hover
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);

      // Accessibility: keyboard arrows
      root.addEventListener('keydown', (e)=>{
        if(e.key === 'ArrowLeft') { e.preventDefault(); go(i-1, true); }
        if(e.key === 'ArrowRight'){ e.preventDefault(); go(i+1, true); }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Rev Carousel",
  "settings": [
    { "type": "color", "id": "bg", "label": "Cor do círculo de fundo", "default": "#f4e07a" },
    {
      "type": "select", "id": "aspect_ratio", "label": "Proporção",
      "default": "4 / 5",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3",  "label": "4:3" },
        { "value": "1 / 1",  "label": "1:1" },
        { "value": "4 / 5",  "label": "4:5 (vertical)" }
      ]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Intervalo (s)", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "transition_ms", "label": "Duração da transição (ms)", "min": 200, "max": 2000, "step": 50, "default": 650 },
    { "type": "checkbox", "id": "loop", "label": "Loop infinito", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar setas", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar pontos", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "alt", "label": "Alt text" },   // <- sem "default"
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Rev Carousel" }]
}
{% endschema %}
