{% comment %} REVISSANT: Pre-Checkout (Cart) {% endcomment %}

<section class="cart">
  <h1 class="cart__title">Cesto</h1>

  {% if cart == empty %}
    <p>O seu cesto está vazio.</p>
    <a href="/collections/all">Continuar a comprar</a>
  {% else %}
    <div class="cart__grid">
      <!-- Esquerda: linhas do carrinho -->
      <div class="cart__left">
        <ul class="cart-lines" role="list">
            {% for item in cart.items %}
              {% render 'cart-line-item', item: item %}
            {% endfor %}
        </ul>
        {% render 'cart-recommendations', title: 'Recomendado para si', limit: 8 %}

      </div>

      <!-- Direita: resumo -->
      <aside class="cart__right">
        <div class="summary" role="complementary" aria-label="Resumo do carrinho">
          <details class="summary-discount">
            <summary class="summary-header">
              <span>Desconto</span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <div class="discount-field">
              <input type="text" id="discount-code" placeholder="Código promocional" />
              <button type="button" id="apply-discount" class="btn btn--ghost">Aplicar</button>
            </div>
          </details>

          <div class="summary-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="summary-row summary-row--total">
            <span>Total estimado</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p class="summary-note">Encargos e impostos incluídos. Portes calculados no checkout.</p>

          <div class="summary-pay">
            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit" name="checkout" class="btn btn--primary btn--xl w-100">
                Continuar para pagamento
              </button>
            </form>

            {% if additional_checkout_buttons %}
              <div class="accelerated-checkout">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {% endif %}
          </div>

        </div>
      </aside>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Pre-checkout (Cart)",
  "settings": []
}
{% endschema %}

{% stylesheet %}
.cart { padding: 1rem; }

/* Grid */
.cart__grid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
@media (min-width: 960px){ .cart__grid { grid-template-columns: minmax(0,1fr) 380px; } }

/* Lista (esquerda) */
.cart-lines { display:flex; flex-direction:column; gap:1rem; }
.cart-line { border-bottom:1px solid #f0f0f0; padding-bottom:1rem; }

/* Card resumo (direita) */
.cart__right .summary {
  position: sticky; top: 1rem;
  background:#fff; border:1px solid #e8e8e8; border-radius:12px; padding:16px;
}
.summary-row { display:flex; justify-content:space-between; align-items:center; margin:.5rem 0; }
.summary-row--total { border-top:1px solid #eee; padding-top:.75rem; font-weight:600; }


.discount-field { display:flex; gap:.5rem; margin:.6rem 0 1rem; }
.discount-field input { flex:1; border:1px solid #ddd; border-radius:8px; padding:.7rem; }

.summary-note { color:#666; font-size:.9rem; margin:.5rem 0 1rem; }

.summary .additional-checkout-buttons,
.summary .shopify-payment-button { width:100%; display:block; margin-top:.75rem; }
.summary .shopify-payment-button__button,
.summary .shopify-payment-button [role="button"] { width:100%; }

.w-100{width:100%}
.btn{display:inline-flex; align-items:center; justify-content:center; border:1px solid #111; padding:.9rem 1.2rem; border-radius:8px; text-decoration:none}
.btn--primary{background:#111; color:#fff}
.btn--ghost{background:transparent; color:#111}
.btn--xl{padding:1rem 1.4rem; font-size:1rem}

/* linha de item */
.cart-item{
  display:grid;
  grid-template-columns:80px 1fr auto;
  gap:1rem; align-items:center;
  border-bottom:1px solid #eee; padding:.75rem 0;
}
.cart-item__thumb img{width:80px;height:80px;object-fit:cover;border-radius:8px}
.cart-item__title{font-weight:600; display:inline-block}
.cart-item__meta{color:#666;font-size:.9rem;margin-top:.25rem;display:flex;gap:.5rem;flex-wrap:wrap}
.cart-item__controls{display:flex;align-items:center;gap:.5rem;margin-top:.5rem}
.qty-form{display:inline-flex;align-items:center;border:1px solid #ddd;border-radius:8px;overflow:hidden}
.qty-btn{background:#f5f5f5;border:0;width:32px;height:32px;line-height:32px}
.qty-input{width:48px;border:0;text-align:center}
.remove-btn{background:transparent;border:0;color:#666}
.cart-item__price{font-weight:600;white-space:nowrap}


.cart-recs{ margin-top:2rem; }
.cart-recs__title{ margin-bottom:.75rem; font-size:1.1rem; }
.recs__grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
@media(min-width:700px){ .recs__grid{ grid-template-columns:repeat(4,minmax(0,1fr)); } }
.card{ border:1px solid #eee; border-radius:10px; overflow:hidden; background:#fff; }
.card__img{ width:100%; aspect-ratio:1/1; object-fit:cover; display:block; }
.card__body{ padding:.6rem; }
.card__title{ font-size:.95rem; line-height:1.3; }
.card__price{ font-weight:600; margin-top:.25rem; }


/* Títulos */
.cart__title{ font-size: clamp(1.6rem, 2.2vw, 2.1rem); font-weight: 700; }   /* antes estava demasiado grande */
.cart-recs__title{ font-size: clamp(1.1rem, 1.6vw, 1.3rem); font-weight: 600; }  /* maior que antes */

/* Linha de item — grelha semelhante ao exemplo */
.cart-line{ border-bottom:1px solid #eee; } /* legacy */
.cart-item{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto; /* info à esquerda, preço à direita */
  align-items:center;
  gap:1rem;
  padding:1rem 0;
  border-bottom:1px solid #eee;
}
.cart-item__main{
  display:grid;
  grid-template-columns:96px 1fr; /* miniatura ~96px */
  gap:1rem;
  align-items:center;
}
.cart-item__thumb .thumb-img{ width:96px; height:96px; object-fit:cover; border-radius:8px; display:block; }

.cart-item__title{ font-weight:600; line-height:1.25; display:inline-block; }
.cart-item__variant{ color:#666; font-size:.9rem; margin-top:.25rem; }

.cart-item__actions{ display:flex; align-items:center; gap:.6rem; margin-top:.6rem; }
.qty-form{ display:inline-flex; align-items:center; border:1px solid #ddd; border-radius:10px; overflow:hidden; }
.qty-btn{ width:34px; height:34px; background:#f6f6f6; border:0; }
.qty-input{ width:56px; border:0; text-align:center; }

.icon-btn{ background:transparent; border:0; color:#666; padding:.25rem .35rem; }
.icon-btn:hover{ color:#111; }

.cart-item__price{ font-weight:600; white-space:nowrap; }

/* Responsivo: empilha no mobile */
@media (max-width: 640px){
  .cart-item{ grid-template-columns:1fr; }
  .cart-item__price{ justify-self:end; }
}


/* descer a zona de pagamento */
.summary-pay { margin-top: 1.25rem; }
@media (min-width: 960px){ .summary-pay { margin-top: 1.5rem; } }

/* botão principal */
.btn--primary{ min-height: 48px; border-radius: 10px; font-weight: 600; }
.btn--xl{ font-size: .95rem; padding: 0 1.2rem; } /* altura vem do min-height */

/* botões acelerados (Shop Pay / PayPal / GPay) */
.summary .shopify-payment-button{ margin-top: .75rem; }
.summary .shopify-payment-button__button{ min-height: 48px; border-radius: 10px; }
.summary .additional-checkout-buttons{ margin-top: .5rem; }
.summary .additional-checkout-buttons > *{ width: 100% !important; }
.summary .additional-checkout-buttons iframe{ width: 100% !important; } /* PayPal */


/* espaço entre o botão principal e os acelerados */
.summary-pay + .accelerated-checkout,
.summary .accelerated-checkout { margin-top: 1rem; }

/* garantir gap entre cada acelerado (Shop Pay / PayPal / GPay) */
.summary .accelerated-checkout > * { width: 100% !important; display: block; }
.summary .accelerated-checkout > * + * { margin-top: .5rem; }

/* “cinto e suspensórios” caso rendam fora do wrapper */
.summary .shopify-payment-button { margin-top: 1rem !important; }
.summary .additional-checkout-buttons { margin-top: .5rem !important; }
.summary .additional-checkout-buttons > * + * { margin-top: .5rem; }

/* Header do acordeão "Desconto" com ícone + à direita */
.summary-discount summary {
  display: grid;
  grid-template-columns: 1fr auto;   /* texto à esquerda, ícone à direita */
  align-items: center;
  padding: .75rem 0;
  font-weight: 600;
  cursor: pointer;
  list-style: none;                   /* remove o triângulo nativo */
}
.summary-discount summary::-webkit-details-marker { display: none; }

/* Ícone + / – */
.summary-discount .toggle {
  width: 20px; height: 20px;
  border: 1px solid #d9d9d9;
  border-radius: 50%;
  position: relative;
}
.summary-discount .toggle::before,
.summary-discount .toggle::after {
  content: "";
  position: absolute;
  background: #111;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
}
.summary-discount .toggle::before {  /* traço horizontal */
  width: 10px; height: 2px;
}
.summary-discount .toggle::after {   /* traço vertical (forma o +) */
  width: 2px; height: 10px;
}
/* Quando o acordeão está aberto vira “–” (esconde o traço vertical) */
.summary-discount[open] .toggle::after { opacity: 0; }


{% endstylesheet %}

{% javascript %}

document.querySelectorAll('.qty-form').forEach(form=>{
  form.addEventListener('click', (e)=>{
    const btn = e.target.closest('.qty-btn');
    if(!btn) return;
    e.preventDefault();
    const input = form.querySelector('.qty-input');
    const delta = parseInt(btn.dataset.change,10);
    const nv = Math.max(0, parseInt(input.value||'0',10) + delta);
    input.value = nv;
    form.submit();
  });
});

document.addEventListener('DOMContentLoaded', function(){
  const btn = document.getElementById('apply-discount');
  if (btn) {
    btn.addEventListener('click', function(){
      const el = document.getElementById('discount-code');
      const code = el ? el.value.trim() : '';
      if (code) window.location.href = `/checkout?discount=${encodeURIComponent(code)}`;
    });
  }
});

document.querySelectorAll('.qty-form').forEach(form=>{
  form.addEventListener('click', (e)=>{
    const btn = e.target.closest('.qty-btn');
    if(!btn) return;
    e.preventDefault();
    const input = form.querySelector('.qty-input');
    const delta = parseInt(btn.dataset.change,10);
    const nv = Math.max(0, parseInt(input.value || '0',10) + delta);
    input.value = nv;
    form.submit();
  });
});
{% endjavascript %}
